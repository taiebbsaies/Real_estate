# URI MongoDB utilisée par Mongoose
MONGODB_URI="mongodb://localhost:27017/homecheck"

# Secret JWT (minimum 32 caractères) utilisé pour signer les cookies de session.
# Obligatoire : sans cette variable, la création et la vérification des sessions échouent.
# Générer un secret : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Fournisseur IA pour la saisie de dépense en langage naturel
# (utilisé par la variante multi-fournisseurs de lib/ai/model.ts : "openai" | "google" | "anthropic")
AI_PROVIDER="google"
# Identifiant du modèle (défaut : "gemini-3.6-flash" ; ex. OpenAI : "gpt-5-mini")
AI_MODEL="gemini-3.6-flash"
# Clé du fournisseur choisi (une seule requise ; jamais exposée au client)
GOOGLE_GENERATIVE_AI_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# Scan de justificatif (/budget/depenses/nouvelle) :
# true (défaut) = le fichier est envoyé au modèle (vision) ; les PDF avec couche
# texte passent toujours par le pipeline texte, sans vision.
# false = repli OCR local (tesseract.js) pour les images ; un PDF scanné est refusé.
AI_VISION="true"

# Classification automatique des réclamations : tout service compatible OpenAI (ex. Groq).
# Sans AI_API_KEY et AI_MODEL_2, les réclamations sont enregistrées « à vérifier ».
AI_API_KEY=""
AI_MODEL_2="openai/gpt-oss-20b"
AI_BASE_URL="https://api.groq.com/openai/v1"

# Photos de maintenance et des logements : sur Vercel, le store Blob connecté au projet suffit (aucun jeton requis).
# Facultatif en local : sans cette variable, les photos sont enregistrées dans uploads/maintenance
# et public/uploads/properties.
BLOB_READ_WRITE_TOKEN=""
